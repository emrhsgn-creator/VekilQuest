{
  "name": "vekilquest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VekilQuest — marka vekilliği sınavı için soru çözme, konu analizi ve eksik tespiti uygulaması",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "soru:ice-aktar": "node tools/pdf-to-json.mjs",
    "soru:dogrula": "node tools/validate-bank.mjs",
    "test": "node --test tools/*.test.mjs",
    "banka:uret": "node tools/soru-bankasi-uret.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
